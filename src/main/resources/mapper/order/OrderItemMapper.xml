<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.familyfood.order.dao.OrderItemMapper">
    <select id="selectByOrderIds" resultType="com.familyfood.order.entity.OrderItem">
        select
            id,
            order_id,
            dish_id,
            dish_name_snapshot,
            quantity,
            unit,
            note
        from order_item
        where order_id in
        <foreach collection="orderIds" item="orderId" open="(" separator="," close=")">
            #{orderId}
        </foreach>
        order by order_id asc, id asc
    </select>
</mapper>
